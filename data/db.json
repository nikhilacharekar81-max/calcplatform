      "contentSections": [
        {
          "id": "sec_how_to_use",
          "sectionType": "how-to",
          "title": "How to Calculate Your Income Tax Liability",
          "content": "<p>Follow these steps to estimate your progressive income tax:</p><ol><li><strong>Select your Jurisdiction:</strong> Choose US Federal or India tax framework.</li><li><strong>Enter Annual Gross Income:</strong> Input your total annual gross salary or revenue before deductions.</li><li><strong>Set Filing Status:</strong> Select single, married joint, or head of household status.</li><li><strong>Apply Deductions:</strong> Enable standard deduction or enter custom retirement contributions (401k, IRA, 80C).</li><li><strong>View Breakdown:</strong> Review your progressive tax bracket breakdown and net monthly take-home salary.</li></ol>",
          "order": 1,
          "isEnabled": true
        },
        {
          "id": "sec_assumptions",
          "sectionType": "assumptions",
          "title": "Tax Calculation Assumptions & Statutory Rules",
          "content": "<p>This calculator incorporates standard statutory tax brackets:</p><ul><li>US Federal tax rates include 10%, 12%, 22%, 24%, 32%, 35%, and 37% progressive marginal rates.</li><li>India New Tax Regime includes standard deduction of ₹75,000 and Section 87A rebate for taxable income up to ₹12 Lakhs.</li><li>Estimates reflect federal individual income tax obligations and do not include state or municipal local income taxes.</li></ul>",
          "order": 2,
          "isEnabled": true
        }
      ],
      "faqs": [
        {
          "id": "faq_1",
