    {
      "id": "calc_income_tax_2026",
      "name": "Income Tax Calculator",
      "slug": "income-tax-calculator",
      "shortDescription": "Calculate federal income tax liabilities, progressive tax brackets, effective rate, and net take-home pay.",
      "categoryId": "cat_1790504986048_uai46",
      "subcategoryId": "sub_1790505115006_ra7ky",
      "engineType": "custom_formula",
      "fields": [
        {
          "id": "jurisdiction",
          "label": "Tax Jurisdiction",
          "type": "select",
          "defaultValue": "US",
          "options": [
            {
              "label": "US Federal (2025/2026)",
              "value": "US"
            },
            {
              "label": "India (FY 2025-26)",
              "value": "IN"
            }
          ]
        },
        {
          "id": "grossIncome",
          "label": "Gross Annual Income",
          "type": "number",
          "defaultValue": 85000,
          "min": 0,
          "max": 10000000,
          "step": 1000,
          "prefix": "$",
          "helpText": "Total annual gross salary or business revenue before deductions."
        },
        {
          "id": "filingStatus",
          "label": "Filing Status (US)",
          "type": "select",
          "defaultValue": "single",
          "options": [
            {
              "label": "Single",
              "value": "single"
            },
            {
              "label": "Married Filing Jointly",
              "value": "married"
            },
            {
              "label": "Head of Household",
              "value": "head"
            }
          ]
        },
        {
          "id": "indiaRegime",
          "label": "Tax Regime (India)",
          "type": "select",
          "defaultValue": "new",
          "options": [
            {
              "label": "New Regime (Default)",
              "value": "new"
            },
            {
              "label": "Old Regime",
              "value": "old"
            }
          ]
        },
        {
          "id": "useStandardDeduction",
          "label": "Use Standard Deduction?",
          "type": "checkbox",
          "defaultValue": true
        },
        {
          "id": "additionalDeductions",
          "label": "Retirement & Itemized Deductions",
          "type": "number",
          "defaultValue": 0,
          "min": 0,
          "step": 500,
          "prefix": "$",
          "helpText": "401(k), IRA, 80C/80D or itemized deductions."
        }
      ],
      "outputs": [
        {
          "id": "totalDeduction",
          "label": "Total Deductions & Exemptions",
          "formula": "(useStandardDeduction ? (jurisdiction == \"IN\" ? (indiaRegime == \"new\" ? 75000 : 50000) : (filingStatus == \"married\" ? 30000 : (filingStatus == \"head\" ? 22500 : 15000))) : 0) + additionalDeductions",
          "format": "currency",
          "prefix": "$"
        },
        {
          "id": "taxableIncome",
          "label": "Net Taxable Income",
          "formula": "max(0, grossIncome - totalDeduction)",
          "format": "currency",
          "prefix": "$"
        },
        {
          "id": "totalTax",
          "label": "Total Tax Liability",
          "formula": "jurisdiction == \"IN\" ? tax_in(taxableIncome, indiaRegime) : tax_us(taxableIncome, filingStatus)",
          "format": "currency",
          "prefix": "$"
        },
        {
          "id": "effectiveRate",
          "label": "Effective Tax Rate",
          "formula": "grossIncome > 0 ? (totalTax / grossIncome) * 100 : 0",
          "format": "percent",
          "suffix": "%"
        },
        {
          "id": "marginalRate",
          "label": "Marginal Tax Bracket",
          "formula": "jurisdiction == \"IN\" ? tax_in_marginal(taxableIncome, indiaRegime) : tax_us_marginal(taxableIncome, filingStatus)",
          "format": "percent",
          "suffix": "%"
        },
        {
          "id": "takeHomePay",
          "label": "Annual Net Take-Home Salary",
          "formula": "max(0, grossIncome - totalTax)",
          "format": "currency",
          "prefix": "$"
        },
        {
          "id": "monthlyTakeHome",
          "label": "Monthly Net Take-Home Pay",
          "formula": "takeHomePay / 12",
          "format": "currency",
          "prefix": "$"
        },
        {
          "id": "biWeeklyTakeHome",
          "label": "Bi-Weekly Net Pay (26x)",
          "formula": "takeHomePay / 26",
          "format": "currency",
          "prefix": "$"
        }
      ],
